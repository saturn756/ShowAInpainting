[Unit]
Description=Anomaly Generation GPU Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=anomaly-gpu
WorkingDirectory=/srv/anomaly-gpu
EnvironmentFile=/etc/anomaly-gpu/gpu.env
ExecStart=/usr/bin/python3 -m gpu_service.server --config /etc/anomaly-gpu/gpu.toml
Restart=on-failure
RestartSec=10
TimeoutStartSec=1800
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
