# Local smoke-test environment. Keep deployment secrets in a protected
# EnvironmentFile or secret manager, never in a committed .env file.
GPU_CONFIG_PATH=./configs/gpu.example.toml
LOGIC_CONFIG_PATH=./configs/logic.example.toml
GPU_SERVICE_API_KEY=replace-with-a-long-random-secret

GRADIO_ACTIVATION_CODE=ABCDE
GRADIO_SESSION_SECRET=replace-with-at-least-32-random-characters
GPU_SERVICE_URL=http://127.0.0.1:7861
DIRECT_OSS_UPLOAD_ENABLED=0
GPU_OSS_ENABLED=0
SERVICE_SMOKE_MODE=1
GPU_RUNTIME_BACKEND=mock
